pub const K_HOUR_CYCLE_SHIFT: u32 = 0;
pub const K_HOUR_CYCLE_MASK: u32 = ((1 << 3) - 1) << 0;
/// v8: src/objects/js-date-time-format.h date_style: shift=3 bits=3
pub const K_DATE_STYLE_SHIFT: u32 = 3;
pub const K_DATE_STYLE_MASK: u32 = ((1 << 3) - 1) << 3;
/// v8: src/objects/js-date-time-format.h time_style: shift=6 bits=3
pub const K_TIME_STYLE_SHIFT: u32 = 6;
pub const K_TIME_STYLE_MASK: u32 = ((1 << 3) - 1) << 6;
/// v8: src/objects/js-date-time-format.h has_to_locale_string_time_zone: shift=9 bits=1
pub const K_HAS_TO_LOCALE_STRING_TIME_ZONE_SHIFT: u32 = 9;
pub const K_HAS_TO_LOCALE_STRING_TIME_ZONE_MASK: u32 = ((1 << 1) - 1) << 9;
/// v8: src/objects/js-date-time-format.h explicit_components_in_options: shift=10 bits=11
pub const K_EXPLICIT_COMPONENTS_IN_OPTIONS_SHIFT: u32 = 10;
pub const K_EXPLICIT_COMPONENTS_IN_OPTIONS_MASK: u32 = ((1 << 11) - 1) << 10;

/// v8: src/objects/js-date-time-format.h JSDateTimeFormat 字段: locale_ offset=24,
///   icu_locale_ 32, icu_simple_date_format_ 40, icu_date_interval_format_ 48,
