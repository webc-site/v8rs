pub const K_HOURS_STYLE_SHIFT: u32 = 10; // 3 bits
pub const K_MINUTES_STYLE_SHIFT: u32 = 13; // 3 bits
pub const K_SECONDS_STYLE_SHIFT: u32 = 16; // 3 bits
pub const K_MILLISECONDS_STYLE_SHIFT: u32 = 19; // 3 bits
pub const K_MICROSECONDS_STYLE_SHIFT: u32 = 22; // 3 bits
pub const K_NANOSECONDS_STYLE_SHIFT: u32 = 25; // 3 bits
pub const K_SEPARATOR_SHIFT: u32 = 28; // 2 bits

// ── display_flags_ 位布局 (uint31 Smi, 总 14 位; = tq DisplayFlags) ──
pub const K_YEARS_DISPLAY_SHIFT: u32 = 0; // 1 bits
pub const K_MONTHS_DISPLAY_SHIFT: u32 = 1; // 1 bits
pub const K_WEEKS_DISPLAY_SHIFT: u32 = 2; // 1 bits
pub const K_DAYS_DISPLAY_SHIFT: u32 = 3; // 1 bits
pub const K_HOURS_DISPLAY_SHIFT: u32 = 4; // 1 bits
pub const K_MINUTES_DISPLAY_SHIFT: u32 = 5; // 1 bits
pub const K_SECONDS_DISPLAY_SHIFT: u32 = 6; // 1 bits
pub const K_MILLISECONDS_DISPLAY_SHIFT: u32 = 7; // 1 bits
pub const K_MICROSECONDS_DISPLAY_SHIFT: u32 = 8; // 1 bits
pub const K_NANOSECONDS_DISPLAY_SHIFT: u32 = 9; // 1 bits
pub const K_FRACTIONAL_DIGITS_SHIFT: u32 = 10; // 4 bits

/// v8: src/objects/js-duration-format.h JSDurationFormat: style_flags_ offset=24 (Smi),
///   display_flags_ 32 (Smi), icu_locale_ 40 (Foreign), icu_number_formatter_ 48 (Foreign)
