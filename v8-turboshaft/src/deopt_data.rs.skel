/// v8: src/compiler/turboshaft/deopt-data.h FrameStateData::Instr
/// 树前序编码指令 (注释保留原版操作数说明):
/// kInput,  // 1 Operand: input machine type
/// kUnusedRegister,
/// kDematerializedObject,           // 2 Operands: id, field_count
/// kDematerializedObjectReference,  // 1 Operand: id
/// kArgumentsElements,              // 1 Operand: type
/// kArgumentsLength,
/// kRestLength,
/// kDematerializedStringConcat,  // 1 Operand: id
/// kDematerializedStringConcatReference  // 1 Operand: id
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
#[repr(u8)]
pub enum Instr {
  /// kInput
  input = 0,
  /// kUnusedRegister
  unusedRegister = 1,
  /// kDematerializedObject
  dematerializedObject = 2,
  /// kDematerializedObjectReference
  dematerializedObjectReference = 3,
  /// kArgumentsElements
  argumentsElements = 4,
  /// kArgumentsLength
  argumentsLength = 5,
  /// kRestLength
  restLength = 6,
  /// kDematerializedStringConcat
  dematerializedStringConcat = 7,
  /// kDematerializedStringConcatReference
  dematerializedStringConcatReference = 8,
}

/// v8: src/compiler/turboshaft/deopt-data.h FrameStateData
pub struct FrameStateData {
  /// instructions_ — Instr 序列
  pub instructions: Vec<Instr>,
  /// machine_types_ — kInput 的机器类型
  pub machine_types: Vec<()>,
  /// int_operands_ — Dematerialized/ArgumentsElements 的整型操作数
  pub int_operands: Vec<u32>,
  /// inlined_ — 有 parent (kInput 前唯一)
  pub inlined: bool,
}

impl FrameStateData {
  /// v8: src/compiler/turboshaft/deopt-data.h FrameStateData::Builder
