pub struct SimplifiedOptimizationReducer;

impl SimplifiedOptimizationReducer {
  /// REDUCE 面 (5 个):
  /// v8: simplified-optimization-reducer.h REDUCE(TruncateJSPrimitiveToUntagged)
  /// v8: simplified-optimization-reducer.h REDUCE(TruncateJSPrimitiveToWord32OrDeopt)
