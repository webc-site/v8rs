/// 原版 WasmInlinedFunctionData — wasm-in-JS 内联所需元数据
/// v8: wasm-wrappers.h WasmInlinedFunctionData
pub struct WasmInlinedFunctionData {
  /// 原版  wasm::NativeModule* native_module
  pub native_module: ,
  /// 原版 uint32_t function_index
  pub function_index: uint32_t,
  /// 原版 V<EagerFrameState> js_caller_frame_state
  pub js_caller_frame_state: V<EagerFrameState>,
  /// 原版 Handle<SharedFunctionInfo> shared_fct_info
  pub shared_fct_info: Handle<SharedFunctionInfo>,
  /// 原版 SourcePosition call_pos
  pub call_pos: SourcePosition,
}

/// 原版 WasmBodyInliningResult — 内联成败 + 结果值
