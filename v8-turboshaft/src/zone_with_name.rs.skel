  pub fn new<T>(&mut self) -> ZoneWithNamePointer<T, NAME> { todo!() }
  /// v8: AllocateArray
  pub fn allocate_array<T>(&mut self, len: usize) -> ZoneWithNamePointer<T, NAME> { todo!() }
  /// v8: Destroy — scope_.Destroy()
