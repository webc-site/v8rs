// 由 tool/src/compiler/turboshaft/runtime-call-descriptors.h.js 从 v8/src/compiler/turboshaft/runtime-call-descriptors.h 生成; 修订就地改, 复跑覆盖
// 运行时调用描述符表

/// 原版 runtime::Descriptor — 每条对应一个 Runtime::k 函数的 Turboshaft
/// 调用描述符; Create() 经 Linkage::GetRuntimeCallDescriptor 装配,
/// kCanTriggerLazyDeopt && caller_can_deopt 时挂 kNeedsFrameState。
/// 默认 kEffects = CanCallAnything; Void/Never 以 V<Any> 哨兵表达。
/// v8: src/compiler/turboshaft/runtime-call-descriptors.h runtime
pub struct RuntimeCallDescriptor {
  /// 原版 kFunction (Runtime::kXxx)
  pub function: RuntimeFunctionId,
  /// 原版 Arguments (ARG 展开)
  pub args: &'static [(&'static str, Type)],
  /// 原版 returns_t
  pub returns: Type,
  /// 原版 kCanTriggerLazyDeopt
  pub can_trigger_lazy_deopt: bool,
  /// 原版 kProperties (Operator::kNoProperties / kNoWrite / kFoldable / ...)
  pub properties: OperatorProperties,
  /// 原版自定义 kEffects (None = 默认 CanCallAnything)
  pub effects: Option<OpEffects>,
}

pub const RUNTIME_CALL_DESCRIPTORS: &[RuntimeCallDescriptor] = &[
  /// Abort: Runtime::kAbort, 返回 V<Object>, lazy_deopt=false
  RuntimeCallDescriptor { function: RuntimeFunctionId::Abort, args: &[("messageOrMessageId", Type::Smi)], returns: Type::Object, can_trigger_lazy_deopt: false, properties: _PROPS, effects: None },
  /// BigIntUnaryOp: Runtime::kBigIntUnaryOp, 返回 V<BigInt>, lazy_deopt=false
  RuntimeCallDescriptor { function: RuntimeFunctionId::BigIntUnaryOp, args: &[("x", Type::BigInt), ("opcode", Type::Smi)], returns: Type::BigInt, can_trigger_lazy_deopt: false, properties: _PROPS, effects: None },
  /// DateCurrentTime: Runtime::kDateCurrentTime, 返回 V<Number>, lazy_deopt=false, 无参
