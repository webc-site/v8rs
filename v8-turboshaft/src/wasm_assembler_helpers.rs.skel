// wasm 汇编 helper: 实例字段载入宏与写屏障换算

/// 原版 4 个 LOAD 宏 — 从 WasmTrustedInstanceData 载字段:
/// - LOAD_INSTANCE_FIELD(instance, name, representation): __ Load + representation (TaggedBase()), 偏移 WasmTrustedInstanceData::k<name>Offset
/// - LOAD_PROTECTED_INSTANCE_FIELD(instance, name, type): LoadProtectedPointerField + V<type>::Cast (TaggedBase()), 偏移 WasmTrustedInstanceData::kProtected<name>Offset
/// - LOAD_IMMUTABLE_PROTECTED_INSTANCE_FIELD(instance, name, type): LoadProtectedPointerField + V<type>::Cast (TaggedBase().Immutable()), 偏移 WasmTrustedInstanceData::kProtected<name>Offset
/// - LOAD_IMMUTABLE_INSTANCE_FIELD(instance, name, representation): __ Load + representation (TaggedBase().Immutable()), 偏移 WasmTrustedInstanceData::k<name>Offset
/// Rust 侧以泛型函数替代宏拼接。
/// v8: src/compiler/turboshaft/wasm-assembler-helpers.h
pub fn load_instance_field<T: InstanceField>(
  asm: &mut Assembler, instance: V<WasmTrustedInstanceData>, name: T,
) -> V<T::Repr> { todo!() }
pub fn load_protected_instance_field<T: InstanceField>(
  asm: &mut Assembler, instance: V<WasmTrustedInstanceData>, name: T,
) -> V<T::Repr> { todo!() }

