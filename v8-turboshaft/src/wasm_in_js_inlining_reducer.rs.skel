/// - F32Const
/// - F64Const
/// - RefNull
/// - RefFunc
/// - RefAsNonNull
/// - Drop
/// - LocalGet
/// - LocalSet
/// - LocalTee
/// - GlobalGet
/// - GlobalSet
/// - Forward
/// - DoReturn
/// - Trap
/// - AssertNullTypecheck
/// - AssertNotNullTypecheck
/// - StructGet
/// - StructSet
/// - ArrayGet
/// - ArraySet
