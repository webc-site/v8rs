// 由 tool/src/objects/fixed-array-inl.h.js 从 v8/src/objects/fixed-array-inl.h 生成; 修订就地改, 复跑覆盖
// 对数骨架 (审计专用): 40 qualified 方法全集处置表 (落地 28 / 推迟登记 12); 落地以 fixed_array.rs 就地修订为准

//! fixed-array-inl.h → fixed_array.rs 合并指引
//!
//! 对数处置 (40 qualified / 55 出现):
//! - TaggedArrayBase<D, ElementT_, P>::IsInBounds → fn is_in_bounds
//! - TaggedArrayBase<D, ElementT_, P>::IsCowArray → fn is_cow_array
//! - TaggedArrayBase<D, ElementT_, P>::get → fn get
//! - TaggedArrayBase<D, ElementT_, P>::get → fn get_relaxed
//! - TaggedArrayBase<D, ElementT_, P>::get → fn get_acquire
//! - TaggedArrayBase<D, ElementT_, P>::get → fn get_seqcst
//! - TaggedArrayBase<D, ElementT_, P>::set → fn set
//! - TaggedArrayBase<D, ElementT_, P>::set → fn set_relaxed
//! - TaggedArrayBase<D, ElementT_, P>::set → fn set_release
//! - TaggedArrayBase<D, ElementT_, P>::set → fn set_seqcst
//! - TaggedArrayBase<D, ElementT_, P>::set → fn set_smi
//! - TaggedArrayBase<D, ElementT_, P>::set → fn set_smi_relaxed
//! - TaggedArrayBase<D, ElementT_, P>::set → fn set_smi_release
//! - TaggedArrayBase<D, ElementT_, P>::set → fn set_smi_seqcst
//! - TaggedArrayBase<D, ElementT_, P>::swap → fn swap
//! - TaggedArrayBase<D, ElementT_, P>::compare_and_swap → fn compare_and_swap
//! - TaggedArrayBase<D, ElementT_, P>::CopyElements → fn copy_elements
//! - TaggedArrayBase<D, ElementT_, P>::RightTrim → fn right_trim
//! - TaggedArrayBase<D, ElementT_, P>::AllocatedSize → fn allocated_size
//! - TaggedArrayBase<D, ElementT_, P>::RawFieldOfFirstElement → fn raw_field_of_first_element
//! - TaggedArrayBase<D, ElementT_, P>::RawFieldOfElementAt → fn raw_field_of_element_at
//! - TaggedArrayBase<D, ElementT_, P>::NewCapacityForIndex → fn new_capacity_for_index
//! - FixedArray::is_the_hole → fn is_the_hole
//! - FixedArray::set_the_hole → fn set_the_hole
//! - FixedArray::FillWithHoles → fn fill_with_holes
//! - FixedArray::CopyElements → fn copy_elements
//! - WeakArrayList::capacity → fn capacity
//! - WeakArrayList::capacity → fn capacity_relaxed
//! - WeakArrayList::length → fn length
//! - WeakArrayList::ulength → fn ulength
//! - WeakArrayList::set_length → fn set_length
//! - WeakArrayList::Get → fn get
//! - WeakArrayList::Set → fn set
//! - WeakArrayList::Set → fn set_smi
//! - WeakArrayList::CopyElements → fn copy_elements
//! - WeakArrayList::AllocatedSize → fn allocated_size
//! - WeakArrayList::Iterator::Next → fn next
//! - ArrayList::length → fn length
//! - ArrayList::ulength → fn ulength
//! - ArrayList::set_length → fn set_length
//! - TaggedArrayBase<D, ElementT_, P>::Allocate → 推迟 (登记锚 "New/Allocate")
//! - TaggedArrayBase<D, ElementT_, P>::MoveElements → 推迟 (登记锚 "MoveElements")
//! - FixedArray::New → 推迟 (登记锚 "New/Allocate")
//! - FixedArray::MoveElements → 推迟 (登记锚 "MoveElements")
//! - TrustedFixedArray::New → 推迟 (登记锚 "New/Allocate")
//! - ProtectedFixedArray::New → 推迟 (登记锚 "New/Allocate")
//! - WeakFixedArray::New → 推迟 (登记锚 "New/Allocate")
//! - WeakHomomorphicFixedArray::New → 推迟 (登记锚 "New/Allocate")
//! - TrustedWeakFixedArray::New → 推迟 (登记锚 "New/Allocate")
//! - ProtectedWeakFixedArray::New → 推迟 (登记锚 "New/Allocate")
//! - ArrayList::New → 推迟 (登记锚 "New/Allocate")
//! - FixedArray::Resize → 推迟 (登记锚 "Resize")
//!
//! 重载展开: TaggedArrayBase::get ×4 → get/get_relaxed/get_acquire/get_seqcst;
//! set ×8 → set/set_relaxed/set_release/set_seqcst + set_smi×4 (SKIP_WRITE_BARRIER);
//! WeakArrayList::capacity ×2 → capacity/capacity_relaxed;
//! set_the_hole ×2 (Isolate/ReadOnlyRoots) → set_the_hole 合并 (hole 值参数注入)。

impl TaggedArrayExtPlaceholder {
  // 落地全集 (TaggedArrayExt / FixedArrayExt / WeakArrayListExt 分 trait 承载):
  pub unsafe fn is_in_bounds(&self, index: u32) -> bool;
  pub unsafe fn is_cow_array(&self, fixed_cow_array_map: Tagged<Map>) -> bool;
  pub unsafe fn get(&self, index: u32) -> Tagged<Self::Element>;
  pub unsafe fn get_relaxed(&self, index: u32) -> Tagged<Self::Element>;
  pub unsafe fn get_acquire(&self, index: u32) -> Tagged<Self::Element>;
  pub unsafe fn get_seqcst(&self, index: u32) -> Tagged<Self::Element>;
  pub unsafe fn set(&self, index: u32, value: Tagged<Self::Element>, mode: WriteBarrierMode);
  pub unsafe fn set_relaxed(&self, index: u32, value: Tagged<Self::Element>, mode: WriteBarrierMode);
  pub unsafe fn set_release(&self, index: u32, value: Tagged<Self::Element>, mode: WriteBarrierMode);
  pub unsafe fn set_seqcst(&self, index: u32, value: Tagged<Self::Element>, mode: WriteBarrierMode);
  pub unsafe fn set_smi(&self, index: u32, value: Tagged<Smi>);
  pub unsafe fn set_smi_relaxed(&self, index: u32, value: Tagged<Smi>);
  pub unsafe fn set_smi_release(&self, index: u32, value: Tagged<Smi>);
  pub unsafe fn set_smi_seqcst(&self, index: u32, value: Tagged<Smi>);
  pub unsafe fn swap(&self, index: u32, value: Tagged<Self::Element>, mode: WriteBarrierMode) -> Tagged<Self::Element>;
  pub unsafe fn compare_and_swap(&self, index: u32, expected: Tagged<Self::Element>, value: Tagged<Self::Element>, mode: WriteBarrierMode) -> Tagged<Self::Element>;
  // MoveElements 族不另设 fn: 原版实体仅 heap->MoveRange 簿记 (L3 推迟),
  // ptr 级重叠语义由 copy_elements (ptr::copy) 统一承接 (模块头追加登记)。
  pub unsafe fn copy_elements(dst: &Self, dst_index: u32, src: &Self, src_index: u32, len: u32, mode: WriteBarrierMode);
  pub fn right_trim(&self, new_capacity: u32) -> Result<()>;
  pub unsafe fn allocated_size(&self) -> usize;
  pub unsafe fn raw_field_of_first_element(&self) -> *mut TaggedSlot;
  pub unsafe fn raw_field_of_element_at(&self, index: u32) -> *mut TaggedSlot;
  pub fn new_capacity_for_index(index: u32, old_capacity: u32) -> u32;
  pub unsafe fn is_the_hole(&self, hole: Tagged<Object>, index: u32) -> bool;
  pub unsafe fn set_the_hole(&self, hole: Tagged<Object>, index: u32);
  pub unsafe fn fill_with_holes(&self, hole: Tagged<Object>, from: u32, to: u32);
  pub unsafe fn capacity(&self) -> u32;
  pub unsafe fn capacity_relaxed(&self) -> u32;
  pub unsafe fn length(&self) -> u32;
  pub unsafe fn ulength(&self) -> u32;
  pub unsafe fn set_length(&self, value: u32);
  pub unsafe fn next(&mut self) -> Option<Tagged<HeapObject>>; // WeakArrayList::Iterator::Next
}
