/// 数字缓存模式 (对应 enum class NumberCacheMode)。
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
#[repr(u8)]
pub enum NumberCacheMode {
  /// kIgnore: 不读不写缓存
  IGNORE = 0,
  /// kSetOnly: 只写
  SET_ONLY = 1,
  /// kBoth: 读写
  BOTH = 2,
}

