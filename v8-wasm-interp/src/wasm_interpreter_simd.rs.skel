// 由 tool/src/wasm/interpreter/wasm-interpreter-simd.cc.js 从 v8/src/wasm/interpreter/wasm-interpreter-simd.cc 生成; 修订就地改, 复跑覆盖
// SIMD 解码: 保留码表与立即数消费区间

//! SIMD 操作码到解释器字节码的译码辅助。
/// v8: src/wasm/interpreter/wasm-interpreter-simd.cc WasmBytecodeGenerator::DecodeSimdOp

/// 保留 (未实现) SIMD 操作码表, 按位置序索引 [opcode & 0xff]
/// 注意: 原版声明 [256] 但显式初始化 255 项 (0xee 注释缺失, 后续注释错位一格),
/// 尾项隐式 false — 本表按 C++ 聚合初始化语义忠实展开。
/// v8: src/wasm/interpreter/wasm-interpreter-simd.cc kIsReservedSimdOpcode
pub static IS_RESERVED_SIMD_OPCODE: [bool; 256] = [
    false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, // 0x0
    false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, // 0x10
    false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, // 0x20
    false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, // 0x30
    false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, // 0x40
    false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, // 0x50
    false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, // 0x60
    false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, // 0x70
    false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, // 0x80
    false, false, false, false, false, false, false, false, false, false, true , false, false, false, false, false, // 0x90
    false, false, true , false, false, true , true , false, false, false, false, false, false, false, false, true , // 0xa0
    true , false, true , true , true , false, false, false, false, false, false, true , false, false, false, false, // 0xb0
    false, false, true , false, false, true , true , false, false, false, false, false, false, false, false, true , // 0xc0
    true , false, true , true , true , false, false, false, false, false, false, false, false, false, false, false, // 0xd0
    false, false, true , false, false, false, false, false, false, false, false, false, false, false, false, false, // 0xe0
    false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, // 0xf0
];

/// relaxed SIMD 接受区间: [0xfd100, 0xfd113] 共 20 个
/// v8: DecodeSimdOp "return opcode <= 0xfd113"
pub const RELAXED_SIMD_MIN: u32 = 0xfd100;
pub const RELAXED_SIMD_MAX: u32 = 0xfd113;
pub const RELAXED_SIMD_COUNT: u32 = RELAXED_SIMD_MAX - RELAXED_SIMD_MIN + 1;

/// 0xfd200 及以上直接拒绝
/// v8: "opcode >= 0xfd200 ||"
pub const SIMD_PREFIX_REJECT_MIN: u32 = 0xfd200;

/// memarg 偏移立即数 48 位上限 (超出即译码失败)
/// v8: "mem_imm.offset >= ((uint64_t)1 << 48)"
pub const MEMARG_OFFSET_MAX: u64 = 1 << 48;

/// v128.const 立即数宽 (16 字节入 simd_immediates_)
/// v8: "*len += 16"
pub const V128_CONST_BYTES: usize = 16;

/// lane 立即数宽 (extract/replace lane 与 load/store lane)
/// v8: "*len += 1" (SimdLaneImmediate)
pub const LANE_IMM_BYTES: usize = 1;

/// v8: 译码不做验证 (模块已验证)
pub const NO_VALIDATE: bool = true;

// —— 提取不变式断言 ——
const _: () = {
    assert_eq!(IS_RESERVED_SIMD_OPCODE.len(), 256);
    assert!(!IS_RESERVED_SIMD_OPCODE[0x00]); // v128.load 已实现
    assert!(IS_RESERVED_SIMD_OPCODE[0x9a]); // (reserved)
    assert_eq!(RELAXED_SIMD_COUNT, 20);
    assert_eq!(MEMARG_OFFSET_MAX, 1 << 48);
};
