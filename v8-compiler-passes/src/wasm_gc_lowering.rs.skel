  pub module: *const wasm::WasmModule,
  /// dead_
  pub dead: *mut Node,
  /// mcgraph_
  pub mcgraph: *const MachineGraph<'z>,
  /// source_position_table_
  pub source_position_table: *mut SourcePositionTable,
}

