// 由 tool/src/compiler/loop-analysis.js 从 v8/src/compiler/loop-analysis.h + src/compiler/loop-analysis.cc 生成; 修订就地改, 复跑覆盖
// LoopTree / LoopFinder / NodeCopier — 循环嵌套树与节点复制器

//! 循环分析: header/body/exits 区间切成树; NodeCopier 供 peel/unroll 复制。

#![allow(dead_code, unused_variables)]

/// v8: src/compiler/loop-analysis.h LoopTree::Loop
/// 区间 [header_start_, body_start_) = header, [body_start_, exits_start_)
/// = body, [exits_start_, exits_end_) = exits (对 LoopTree::node_to_loop_num_ 索引)
pub struct Loop {
  /// 原 parent_ / children_
  pub parent: *mut Loop,
  pub children: Vec<*mut Loop>,
  /// 原 header_start_ / body_start_ / exits_start_ / exits_end_
  pub header_start: u32,
  pub body_start: u32,
  pub exits_start: u32,
  pub exits_end: u32,
  /// 原 depth_
  pub depth: u32,
}

impl Loop {
  /// v8: src/compiler/loop-analysis.h LoopTree::Loop::HeaderSize
  /// 原文: body_start_ - header_start_
  pub const fn header_size(&self) -> u32 {
    self.body_start - self.header_start
  }
  /// v8: src/compiler/loop-analysis.h LoopTree::Loop::BodySize
  /// 原文: exits_start_ - body_start_
  pub const fn body_size(&self) -> u32 {
    self.exits_start - self.body_start
  }
  /// v8: src/compiler/loop-analysis.h LoopTree::Loop::ExitsSize
  /// 原文: exits_end_ - exits_start_
  pub const fn exits_size(&self) -> u32 {
    self.exits_end - self.exits_start
  }
  /// v8: src/compiler/loop-analysis.h LoopTree::Loop::TotalSize
  /// 原文: exits_end_ - header_start_
  pub const fn total_size(&self) -> u32 {
    self.exits_end - self.header_start
  }
  /// v8: src/compiler/loop-analysis.h LoopTree::Loop::depth
  pub const fn depth(&self) -> u32 {
    self.depth
  }
}

/// v8: src/compiler/loop-analysis.h LoopTree
pub struct LoopTree {
  /// 原 zone_
  pub zone: *mut crate::zone::Zone,
  /// 原 outer_loops_ — 顶层循环表
  pub outer_loops: Vec<*mut Loop>,
  /// 原 all_loops_ — 全部循环
  pub all_loops: Vec<*mut Loop>,
  /// 原 node_to_loop_num_ — 节点 id → 循环号 (-1 = 无)
  pub node_to_loop_num: Vec<i32>,
  /// 原 loop_nodes_ — 区间切分用的节点序
  pub loop_nodes: Vec<crate::node::Node>,
}

/// v8: src/compiler/loop-analysis.h LoopFinder::Purpose
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum Purpose {
  /// kLoopPeeling
  LoopPeeling,
  /// kLoopUnrolling
  LoopUnrolling,
}

