/// v8: src/compiler/loop-analysis.h NodeCopier
/// {max}: 追踪上限 (原节点 + 全部副本); {p}: 原节点与副本共表;
/// {copy_count}: 复制份数 (>0); 副本 0-indexed
pub struct NodeCopier {
  /// 原 node_map_
  pub node_map: crate::node_marker::NodeMarker<Vec<crate::node::Node>>,
  /// 原 copies_
  pub copies: *mut Vec<crate::node::Node>,
  /// 原 copy_count_
  pub copy_count: u32,
}

impl NodeCopier {
  /// v8: src/compiler/loop-analysis.h NodeCopier::NodeCopier
  pub fn new(graph: &crate::graph::TFGraph, max: u32, p: *mut Vec<crate::node::Node>, copy_count: u32) -> Self {
    debug_assert!(copy_count > 0);
    Self { node_map: crate::node_marker::NodeMarker::new(graph, max as usize), copies: p, copy_count }
  }

