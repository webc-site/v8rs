// 由 tool/src/compiler/representation-change.h.js 从 v8/src/compiler/representation-change.h 生成; 修订就地改, 复跑覆盖
// 机器表示变更与 Simplified→Machine 转换

//! representation-change — GetRepresentationFor 总分派
//!
//! 三层: 10 个 *OperatorFor (目标表示的等价机器算子) /
//! 9 个 Get*RepresentationFor (目标表示分派) /
//! 14 个 Insert* (插入转换节点);
//! 常量折叠先行, 类型错误走 TypeError 收集。

/// 原版 RepresentationChanger — 表示变更器
pub struct RepresentationChanger<'z, 'g> {
  /// cache_
  pub cache: *const TypeCache,
  /// jsgraph_
  pub jsgraph: &'g JSGraph<'z>,
  /// broker_
  pub broker: *mut JSHeapBroker,
  /// verifier_
  pub verifier: Option<Box<SimplifiedLoweringVerifier<'z, 'g>>>,
  /// testing_type_errors_
  pub testing_type_errors: bool,
  /// type_error_
  pub type_error: bool,
  /// ieee754_fp16_raw_bits_to_fp32_raw_bits_code_ 等 4 个 SetOnce 缓存 (ieee754_fp16_raw_bits_to_fp32_raw_bits_code_/ieee754_fp64_to_fp16_raw_bits_code_/ieee754_fp16_raw_bits_to_fp32_raw_bits_operator_/ieee754_fp64_to_fp16_raw_bits_operator_)
  pub ieee754_caches: [SetOncePtr<Node>; 4],
}

