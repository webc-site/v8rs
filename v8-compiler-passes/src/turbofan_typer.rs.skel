// 图类型标注 (Typer pass)

//! turbofan-typer — Typer + Decorator (新节点即时定型)
//!
//! Visitor 声明面: DECLARE_METHOD(Node) 组: COMMON(47)
//! + SIMPLIFIED_COMPARE(20) + SIMPLIFIED_OTHER(118)
//! + JS_OBJECT(40) + JS_CONTEXT(9)
//! + JS_OTHER(39) = 273;
//! DECLARE_METHOD(Type) 组 (JS_SIMPLE_UNOP): 14;
//! 显式: Start, IfException, ChangeUint32ToUint64, ChangeUint32ToUint64; IMPOSSIBLE(机器): 150。

/// 原版 Typer::Flag 位标志
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash, Default)]
pub struct TyperFlags(u8);

impl TyperFlags {
  /// kNoFlags
  pub const NONE: Self = Self(0);
  /// kThisIsReceiver = 1
  pub const THISISRECEIVER: Self = Self(1);
  /// kNewTargetIsReceiver = 2
  pub const NEWTARGETISRECEIVER: Self = Self(2);
}

/// 原版 Typer — 类型标注 pass
pub struct Typer<'z, 'g> {
  /// flags_
  pub flags: TyperFlags,
  /// graph_
  pub graph: &'g mut TFGraph<'z>,
  /// decorator_
  pub decorator: *mut Decorator,
  /// cache_
  pub cache: *const TypeCache,
  /// broker_
  pub broker: *mut JSHeapBroker,
  /// operation_typer_
  pub operation_typer: OperationTyper<'z>,
  /// singleton_false_ / singleton_true_
  pub singleton_false: Type,
  pub singleton_true: Type,
}

impl Typer<'_, '_> {
  /// 原版 Run — 全图标注 (GraphVisitor)
