// 由 tool/src/compiler/schedule.js 从 v8/src/compiler/schedule.h + schedule.cc 生成; 修订就地改, 复跑覆盖
// 基本块调度结构与图-调度映射

//! schedule — BasicBlock (节点序列 + 控制尾) + Schedule (RPO 序 + node→block 映射)
//!
//! Control 枚举 9 值与原版顺序一致 (判别值参与 JSON 导出);
//! loop_header/loop_end 双向链支撑 LoopContains; dominator_depth 缓存支配深。

/// 原版 BasicBlock::Control — 块尾控制种类 (顺序 = 判别值)
#[derive(Debug, Clone, Copy, PartialEq, Eq, Default)]
pub enum Control {
  /// kNone
  #[default]
  None,
  /// kGoto
  Goto,
  /// kCall
  Call,
  /// kBranch
  Branch,
  /// kSwitch
  Switch,
  /// kDeoptimize
  Deoptimize,
  /// kTailCall
  TailCall,
  /// kReturn
  Return,
  /// kThrow
  Throw,
}

/// 原版 BasicBlock::Id — 块序号 (newtype)
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
pub struct BasicBlockId(pub usize);

/// 原版 BasicBlock — 基本块
pub struct BasicBlock<'z> {
  /// nodes_
  pub nodes: Vec<*mut Node>,
  /// deferred_ — 含延迟代码
  pub deferred: bool,
  /// dominator_depth_
  pub dominator_depth: i32,
  /// dominator_
  pub dominator: Option<*mut BasicBlock<'z>>,
  /// rpo_next_
  pub rpo_next: Option<*mut BasicBlock<'z>>,
  /// loop_header_
  pub loop_header: Option<*mut BasicBlock<'z>>,
  /// loop_end_
  pub loop_end: Option<*mut BasicBlock<'z>>,
  /// loop_depth_
  pub loop_depth: i32,
  /// loop_number_
  pub loop_number: i32,
  /// rpo_number_
  pub rpo_number: i32,
  /// pgo_execution_count_
  pub pgo_execution_count: u64,
  /// control_
  pub control: Control,
  /// control_input_
  pub control_input: *mut Node,
  /// successors_
  pub successors: Vec<*mut BasicBlock<'z>>,
  /// predecessors_
  pub predecessors: Vec<*mut BasicBlock<'z>>,
  /// id_
  pub id: BasicBlockId,
}

