#[cfg(not(feature = "turbofan"))]
pub fn new_js_to_wasm_compilation_job(/* isolate, sig */) -> ! {
  panic!("compiler::NewJSToWasmCompilationJob must not be called when Turbofan is disabled (v8_enable_turbofan = false)")
}
