  /// 原版 GetIdAt
  /// v8: src/compiler/turbofan-graph-visualizer.h SourceIdAssigner::GetIdAt
  pub fn get_id_at(&self, pos: usize) -> i32 {
    self.source_ids[pos]
  }
}

