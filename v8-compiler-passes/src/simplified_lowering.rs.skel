/// 原版 RepresentationSelector — 表示选择器 (simplified-lowering.cc 内部类)
/// setter 面 (2): SetAndCheckInput, SetOutput
/// visit 面 (28): VisitInputs, VisitReturn, VisitUnused, VisitNoop, VisitBinop, VisitBinop, VisitSpeculativeInt32Binop, VisitUnop, VisitLeaf, VisitFloat64Binop, VisitInt64Binop, VisitWord32TruncatingBinop, VisitSelect, VisitPhi, VisitObjectIs, VisitCheck, VisitCall, VisitStateValues, VisitFrameState, VisitObjectState...
pub struct RepresentationSelector<'z, 'g> {
  /// 关联的 lowering
  pub lowering: *mut SimplifiedLowering<'z, 'g>,
}

impl RepresentationSelector<'_, '_> {
  /// 原版 Run — 两遍: 遍历定表示 → 遍历改节点
