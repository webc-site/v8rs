// 由 tool/src/compiler/simplified-lowering.js 从 v8/src/compiler/simplified-lowering.h + simplified-lowering.cc 生成; 修订就地改, 复跑覆盖
// Simplified→Machine 表示选择与降低

//! simplified-lowering — 两层: SimplifiedLowering 门面 + RepresentationSelector
//!
//! 门面 Do* 11 个 (Max/Min/ToBit/Uint8Clamped 族);
//! 数值辅助: Float64(Float64Round/Float64Sign) Int32(Int32Abs/Int32Div/Int32Mod/Int32Sign) Uint32(Uint32Div/Uint32Mod);
//! SetOnce 缓存 6 个; Selector: setter 面 2 / visit 面 28。
/// 原版 SimplifiedLowering — 门面 (jsgraph + 源位置 + origin + 观察)
pub struct SimplifiedLowering<'z, 'g> {
  /// jsgraph_
  pub jsgraph: &'g JSGraph<'z>,
  /// broker_
  pub broker: *mut JSHeapBroker,
  /// zone_
  pub zone: &'z Zone<'z>,
  /// type_cache_
  pub type_cache: *const TypeCache,
  /// to_number_code_ 等 SetOnce 缓存 (to_number_code_/to_number_convert_big_int_code_/to_numeric_code_/to_number_operator_/to_number_convert_big_int_operator_/to_numeric_operator_)  pub caches: SimplifiedLoweringCaches,
  /// source_positions_
  pub source_positions: *mut SourcePositionTable,
  /// node_origins_
  pub node_origins: *mut NodeOriginTable,
  /// tick_counter_
  pub tick_counter: *mut TickCounter,
  /// linkage_
  pub linkage: *mut Linkage,
  /// info_
  pub info: *mut OptimizedCompilationInfo,
  /// observe_node_manager_
  pub observe_node_manager: *mut ObserveNodeManager,
}

/// SetOnce 缓存包 (6 字段)
pub struct SimplifiedLoweringCaches {
  /// to_number_code_
  pub to_number_code_: SetOncePtr<()>,
  /// to_number_convert_big_int_code_
  pub to_number_convert_big_int_code_: SetOncePtr<()>,
  /// to_numeric_code_
  pub to_numeric_code_: SetOncePtr<()>,
  /// to_number_operator_
  pub to_number_operator_: SetOncePtr<()>,
  /// to_number_convert_big_int_operator_
  pub to_number_convert_big_int_operator_: SetOncePtr<()>,
  /// to_numeric_operator_
  pub to_numeric_operator_: SetOncePtr<()>,
}

