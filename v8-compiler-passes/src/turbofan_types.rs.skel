/// kMinusZeroOrNaN = kMinusZero | kNaN
pub const K_MINUSZEROORNAN: Bitset = 0x0000000000001800;
/// kNumber = kOrderedNumber | kNaN
pub const K_NUMBER: Bitset = 0x0000000000001c5e;
/// kSignedBigInt64 = kUnsignedBigInt63 | kNegativeBigInt63
pub const K_SIGNEDBIGINT64: Bitset = 0x0000000014000000;
/// kUnsignedBigInt64 = kUnsignedBigInt63 | kOtherUnsignedBigInt64
pub const K_UNSIGNEDBIGINT64: Bitset = 0x000000000c000000;
/// kBigInt = kSignedBigInt64 | kOtherUnsignedBigInt64 | kOtherBigInt
