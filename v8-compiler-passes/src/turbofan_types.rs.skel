pub const K_BOOLEANORNULLORUNDEFINED: Bitset = 0x0000000000000380;
/// kNullOrNumber = kNull | kNumber
pub const K_NULLORNUMBER: Bitset = 0x0000000000001cde;
/// kNullOrUndefined = kNull | kUndefined
pub const K_NULLORUNDEFINED: Bitset = 0x0000000000000180;
/// kUndetectable = kNullOrUndefined | kOtherUndetectable
