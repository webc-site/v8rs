/// 原版 BitsetType — 位集代数
pub struct BitsetType;

impl BitsetType {
  /// 原版 IsNone / Is — bits ⊆ bits2
  /// v8: src/compiler/turbofan-types.h BitsetType::Is
  pub fn is(bits1: Bitset, bits2: Bitset) -> bool {
    bits1 | bits2 == bits2
  }

  /// 原版 SignedSmall / UnsignedSmall (依指针压缩配置)
