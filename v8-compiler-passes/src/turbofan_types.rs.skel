pub const K_NONBIGINT: Bitset = 0x0000000c427ffffe;
/// kNonNumber = kBigInt | kUnique | kString | kInternal
pub const K_NONNUMBER: Bitset = 0x0000000effffe3a0;
/// kStringOrOddball = kString | kBooleanOrNullOrUndefined
pub const K_STRINGORODDBALL: Bitset = 0x00000000000043a0;
/// kAny = uint64_t{0xfffffffffffffffe}
pub const K_ANY: Bitset = 0xfffffffffffffffe;

/// 原版 TypeBase::Kind — 非位集类型的判别
#[derive(Debug, Clone, Copy, PartialEq, Eq)]
pub enum TypeKind {
  /// kHeapConstant
  HeapConstant,
  /// kOtherNumberConstant
  OtherNumberConstant,
  /// kTuple
  Tuple,
  /// kUnion
  Union,
  /// kRange
  Range,
  /// kWasm
  Wasm,
}

/// 原版 RangeType::Limits — [min, max] 闭区间
#[derive(Debug, Clone, Copy, PartialEq)]
pub struct Limits {
  /// min
  pub min: f64,
  /// max
  pub max: f64,
}

impl Limits {
  /// 原版 IsEmpty — min > max
  /// v8: src/compiler/turbofan-types.cc RangeType::Limits::IsEmpty
  pub fn is_empty(&self) -> bool {
    self.min > self.max
  }

  /// 原版 Empty — Limits(1, 0)
  /// v8: src/compiler/turbofan-types.h RangeType::Limits::Empty
  pub const EMPTY: Self = Self { min: 1.0, max: 0.0 };

