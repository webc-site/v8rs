/// kName = kSymbol | kString
pub const K_NAME: Bitset = 0x0000000000006020;
/// kInternalizedStringOrNull = kInternalizedString | kNull
pub const K_INTERNALIZEDSTRINGORNULL: Bitset = 0x0000000000004080;
/// kBooleanOrNumber = kBoolean | kNumber
pub const K_BOOLEANORNUMBER: Bitset = 0x0000000000001e5e;
/// kBooleanOrNullOrNumber = kBooleanOrNumber | kNull
pub const K_BOOLEANORNULLORNUMBER: Bitset = 0x0000000000001ede;
