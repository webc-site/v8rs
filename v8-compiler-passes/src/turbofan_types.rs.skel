  pub payload: u64,
}

impl Type {
  /// 原版 NewBitset
  /// v8: src/compiler/turbofan-types.h Type::NewBitset
  pub const fn new_bitset(bits: Bitset) -> Self {
    Self { payload: bits }
  }

  /// 原版 IsBitset — payload & 1
  /// v8: src/compiler/turbofan-types.h Type::IsBitset
  pub fn is_bitset(&self) -> bool {
