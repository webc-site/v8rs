/// kIntegral32OrMinusZeroOrNaN = kIntegral32OrMinusZero | kNaN
pub const K_INTEGRAL32ORMINUSZEROORNAN: Bitset = 0x0000000000001c4e;
/// kPlainNumber = kIntegral32 | kOtherNumber
