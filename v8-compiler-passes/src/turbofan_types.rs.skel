// 由 tool/src/compiler/turbofan-types.js 从 v8/src/compiler/turbofan-types.h + turbofan-types.cc 生成; 修订就地改, 复跑覆盖
// TF 类型系统: 位集/范围/堆常量/元组/联合

//! turbofan-types — Type: bitset (payload 偶数低位) | 指针 (TaggedKind)
//!
//! 原子位集 35 个 (internal 5 + low 26 + high 4),
//! 组合位集 67 个; Any = 0xfffffffffffffffe (bit0 保留给指针判别);
//! 原子位互不重叠且并集 == Any|1 (脚本内置断言)。
//! TypeBase::Kind: HeapConstant, OtherNumberConstant, Tuple, Union, Range, Wasm。

/// 原版 BitsetType::bitset
pub type Bitset = u64;

// —— 原子位集 (internal + low + high) ——
/// kOtherUnsigned31 = uint64_t{1} << 1
pub const K_OTHERUNSIGNED31: Bitset = 0x0000000000000002;
/// kOtherUnsigned32 = uint64_t{1} << 2
pub const K_OTHERUNSIGNED32: Bitset = 0x0000000000000004;
/// kOtherSigned32 = uint64_t{1} << 3
pub const K_OTHERSIGNED32: Bitset = 0x0000000000000008;
/// kOtherNumber = uint64_t{1} << 4
pub const K_OTHERNUMBER: Bitset = 0x0000000000000010;
/// kOtherString = uint64_t{1} << 5
pub const K_OTHERSTRING: Bitset = 0x0000000000000020;
/// kNegative31 = uint64_t{1} << 6
pub const K_NEGATIVE31: Bitset = 0x0000000000000040;
/// kNull = uint64_t{1} << 7
pub const K_NULL: Bitset = 0x0000000000000080;
/// kUndefined = uint64_t{1} << 8
pub const K_UNDEFINED: Bitset = 0x0000000000000100;
/// kBoolean = uint64_t{1} << 9
pub const K_BOOLEAN: Bitset = 0x0000000000000200;
/// kUnsigned30 = uint64_t{1} << 10
pub const K_UNSIGNED30: Bitset = 0x0000000000000400;
/// kMinusZero = uint64_t{1} << 11
pub const K_MINUSZERO: Bitset = 0x0000000000000800;
/// kNaN = uint64_t{1} << 12
pub const K_NAN: Bitset = 0x0000000000001000;
/// kSymbol = uint64_t{1} << 13
pub const K_SYMBOL: Bitset = 0x0000000000002000;
/// kInternalizedString = uint64_t{1} << 14
pub const K_INTERNALIZEDSTRING: Bitset = 0x0000000000004000;
/// kOtherCallable = uint64_t{1} << 15
pub const K_OTHERCALLABLE: Bitset = 0x0000000000008000;
/// kOtherObject = uint64_t{1} << 16
pub const K_OTHEROBJECT: Bitset = 0x0000000000010000;
/// kOtherUndetectable = uint64_t{1} << 17
pub const K_OTHERUNDETECTABLE: Bitset = 0x0000000000020000;
/// kCallableProxy = uint64_t{1} << 18
pub const K_CALLABLEPROXY: Bitset = 0x0000000000040000;
/// kOtherProxy = uint64_t{1} << 19
pub const K_OTHERPROXY: Bitset = 0x0000000000080000;
/// kCallableFunction = uint64_t{1} << 20
pub const K_CALLABLEFUNCTION: Bitset = 0x0000000000100000;
/// kClassConstructor = uint64_t{1} << 21
pub const K_CLASSCONSTRUCTOR: Bitset = 0x0000000000200000;
/// kBoundFunction = uint64_t{1} << 22
pub const K_BOUNDFUNCTION: Bitset = 0x0000000000400000;
/// kOtherInternal = uint64_t{1} << 23
pub const K_OTHERINTERNAL: Bitset = 0x0000000000800000;
/// kExternalPointer = uint64_t{1} << 24
pub const K_EXTERNALPOINTER: Bitset = 0x0000000001000000;
/// kArray = uint64_t{1} << 25
pub const K_ARRAY: Bitset = 0x0000000002000000;
/// kUnsignedBigInt63 = uint64_t{1} << 26
pub const K_UNSIGNEDBIGINT63: Bitset = 0x0000000004000000;
/// kOtherUnsignedBigInt64 = uint64_t{1} << 27
pub const K_OTHERUNSIGNEDBIGINT64: Bitset = 0x0000000008000000;
/// kNegativeBigInt63 = uint64_t{1} << 28
pub const K_NEGATIVEBIGINT63: Bitset = 0x0000000010000000;
/// kOtherBigInt = uint64_t{1} << 29
pub const K_OTHERBIGINT: Bitset = 0x0000000020000000;
/// kWasmObject = uint64_t{1} << 30
pub const K_WASMOBJECT: Bitset = 0x0000000040000000;
/// kSandboxedPointer = uint64_t{1} << 31
pub const K_SANDBOXEDPOINTER: Bitset = 0x0000000080000000;
/// kMachine = uint64_t{1} << 32
pub const K_MACHINE: Bitset = 0x0000000100000000;
/// kHole = uint64_t{1} << 33
pub const K_HOLE: Bitset = 0x0000000200000000;
/// kStringWrapper = uint64_t{1} << 34
pub const K_STRINGWRAPPER: Bitset = 0x0000000400000000;
/// kTypedArray = uint64_t{1} << 35
pub const K_TYPEDARRAY: Bitset = 0x0000000800000000;

// —— 组合位集 ——
/// kSigned31 = kUnsigned30 | kNegative31
pub const K_SIGNED31: Bitset = 0x0000000000000440;
/// kSigned32 = kSigned31 | kOtherUnsigned31 | kOtherSigned32
pub const K_SIGNED32: Bitset = 0x000000000000044a;
