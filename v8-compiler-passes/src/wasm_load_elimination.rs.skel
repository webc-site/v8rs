/// 原版 AbstractState — 双 HalfState (可变 mutable_state / 不可变 immutable_state)
pub struct AbstractState<'z> {
  /// mutable_state
  pub mutable_state: *const HalfState<'z>,
  /// immutable_state
  pub immutable_state: *const HalfState<'z>,
}

