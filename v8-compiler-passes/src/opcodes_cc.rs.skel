/// 助记符表 — kMnemonics (与枚举判别值同序, 索引即 opcode)
/// v8: src/compiler/opcodes.cc:18 kMnemonics
pub const MNEMONICS: [&str; IrOpcode::COUNT] = [
  "Start", "Loop", "Branch", "Switch", "IfTrue", "IfFalse", // Start..IfFalse
  "IfSuccess", "IfException", "IfValue", "IfDefault", "Merge", "Deoptimize", // IfSuccess..Deoptimize
  "DeoptimizeIf", "DeoptimizeUnless", "Assert", "TrapIf", "TrapUnless", "Return", // DeoptimizeIf..Return
  "TailCall", "Terminate", "Throw", "End", "ExternalConstant", "NumberConstant", // TailCall..NumberConstant
  "PointerConstant", "HeapConstant", "TrustedHeapConstant", "Int32Constant", "Int64Constant", "TaggedIndexConstant", // PointerConstant..TaggedIndexConstant
  "Float32Constant", "Float64Constant", "CompressedHeapConstant", "RelocatableInt32Constant", "RelocatableInt64Constant", "Select", // Float32Constant..Select
  "Phi", "EffectPhi", "InductionVariablePhi", "Checkpoint", "BeginRegion", "FinishRegion", // Phi..FinishRegion
