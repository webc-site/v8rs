// 由 tool/src/compiler/opcodes.cc.js 从 v8/src/compiler/opcodes.cc + opcodes.h (X-macro 树) 生成; 修订就地改, 复跑覆盖
// IrOpcode 全表 + 助记符表 (kMnemonics); 正典谓词面在 v8-compiler-graph/src/opcodes.rs

//! IrOpcode 助记符面 — opcodes.cc 的 kMnemonics 全表基线。
//!
//! - kMnemonics = ALL_OP_LIST(DECLARE_MNEMONIC) 展开 + 尾槽 "UnknownOpcode"
//! - Mnemonic(value): n = min(value, 表长-1) 钳制后取表 (越界 → 尾槽)
//! - 目标构建: wasm 开 / SIMD128 开 / SIMD256 关 / 硬件沙箱关 / CPED 开
//! - 枚举判别值与 v8-compiler-graph/src/opcodes.rs 同源 (同一 X-macro 展开侧),
//!   挂接时由 Developer 收敛为跨 crate 依赖, 不长期双表
//!
//! 展开计数 (对数): 总 1036 = CONTROL 22 + COMMON 47 + SIMPLIFIED 322 + MACHINE 234 + SIMD128 287 + JS 124

/// IrOpcode — 原版 `enum Value { k##x }`; 变体名去 k 前缀, 判别值 = 展开序
#[derive(Debug, Clone, Copy, PartialEq, Eq, Hash)]
#[repr(u16)]
pub enum IrOpcode {
  // CONTROL_OP_LIST
  Start = 0, Loop, Branch, Switch, IfTrue, IfFalse, IfSuccess, IfException, IfValue, IfDefault,
  Merge, Deoptimize, DeoptimizeIf, DeoptimizeUnless, Assert, TrapIf, TrapUnless, Return, TailCall,
  Terminate, Throw, End,
  // COMMON_OP_LIST
  ExternalConstant, NumberConstant, PointerConstant, HeapConstant, TrustedHeapConstant,
  Int32Constant, Int64Constant, TaggedIndexConstant, Float32Constant, Float64Constant,
