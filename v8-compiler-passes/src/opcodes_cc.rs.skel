  "I32x4RelaxedTruncF64x2SZero", "I32x4RelaxedTruncF64x2UZero", "I16x8RelaxedQ15MulRS", "I16x8DotI8x16I7x16S", "I32x4DotI8x16I7x16AddS", "I8x16AddReduce", // I32x4RelaxedTruncF64x2SZero..I8x16AddReduce
  "I16x8AddReduce", "I32x4AddReduce", "I64x2AddReduce", "F32x4AddReduce", "F64x2AddReduce", "I8x16Shuffle", // I16x8AddReduce..I8x16Shuffle
