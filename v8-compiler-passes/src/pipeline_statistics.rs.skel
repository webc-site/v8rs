/// 原版 PhaseScope — RAII 相位区间
pub struct StatsPhaseScope<'s> {
  /// pipeline_stats_
  pub pipeline_stats: Option<&'s mut TurbofanPipelineStatistics>,
}

/// 原版 PhaseScopeKind — RAII 相位类区间
pub struct StatsPhaseScopeKind<'s> {
  /// pipeline_stats_
  pub pipeline_stats: Option<&'s mut TurbofanPipelineStatistics>,
}
