  pub fn collect_garbage(&mut self) { todo!() }
  /// v8: ScavengerCollector::CompleteSweepingQuarantinedPagesIfNeeded
  pub fn complete_sweeping_quarantined_pages_if_needed(&mut self) { todo!() }
