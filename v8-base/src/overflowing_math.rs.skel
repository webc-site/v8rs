/// v8: src/base/overflowing-math.h MulWithWraparound<int16_t> 特化
/// C++ 整型提升陷阱 (llvm bug 25580): 提升到 uint32 乘后截断; Rust i16::wrapping_mul 等价
pub fn mul_with_wraparound_i16(a: i16, b: i16) -> i16 { a.wrapping_mul(b) }

