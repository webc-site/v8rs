//! v8 侧: 枚举 3+2; 方法 21; 双集布局
//! Rust 策略: BTreeSet<Region> ×2 (AddressEndOrder / SizeAddressOrder) 或 Vec + 排序索引

/// v8: enum class RegionState { // The region can be allocated from.
    kFree, // The region has been carved out of the wider area and is not allocatable.
    kExcluded, // The region has been allocated and is managed by a RegionAllocator.
    kAllocated }
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum RegionState {
    /// v8: // The region can be allocated from.
    kFree
    Free,
    /// v8: // The region has been carved out of the wider area and is not allocatable.
    kExcluded
    Excluded,
    /// v8: // The region has been allocated and is managed by a RegionAllocator.
    kAllocated
    Allocated,
}

/// v8: enum class AllocationStrategy { // Allocates in the first large enough free region.
    kFirstFit, // Allocates in the largest free region.
    kLargestFit }
#[derive(Clone, Copy, Debug, PartialEq, Eq)]
pub enum AllocationStrategy {
    /// v8: // Allocates in the first large enough free region.
    kFirstFit
    FirstFit,
    /// v8: // Allocates in the largest free region.
    kLargestFit
    LargestFit,
}

/// v8: class Region : public AddressRegion (address + size + state_)
#[derive(Clone, Debug)]
pub struct Region {
    pub address: usize,
    pub size: usize,
    /// v8: state_
    pub state: RegionState,
}

/// v8: class RegionAllocator final
/// 布局: whole_region_ + all_regions_ (按地址尾排序) + free_regions_ (按大小/地址排序)
/// 回调: on_split_ / on_merge_ (SplitMergeCallback)
pub struct RegionAllocator {
    /// v8: whole_region_ (构造时 [address, address+size))
    whole_region: (usize, usize),
    /// v8: all_regions_ — AddressEndOrder
    all_regions: std::collections::BTreeSet<Region>,
    /// v8: free_regions_ — SizeAddressOrder
    free_size: usize,
    /// v8: page_size_
    page_size: usize,
}

