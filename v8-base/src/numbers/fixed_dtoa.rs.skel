pub const K_TEN7: u32 = 10000000;
/// v8: src/base/numbers/fixed-dtoa.cc kTen7 = 10000000 (函数内局部)
pub const K_TEN7: u32 = 10000000;
/// v8: src/base/numbers/fixed-dtoa.cc kMaxUInt32 = 0xFFFFFFFF (函数内局部)
