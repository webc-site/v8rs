// 由 tool/src/base/numerics/byte_conversions.h.js 从 v8/src/base/numerics/byte_conversions.h + byte_conversions_unittest.cc 生成; 修订就地改, 复跑覆盖
// 字节序换算 API 矩阵 (10 类型 × 3 端序 × 双向)

//! v8 侧 From*Endian 30 个 + To*Endian 30 个 = 60 函数
//! 类型 10 种: U8, U16, U32, U64, I8, I16, I32, I64, Float, Double; 端序 3 种: Native/Little/Big
//! unittest: 6 个 TEST 用例 (迁移对数基准)
//! Rust 策略: Native → to_ne_bytes; Little → to_le_bytes; Big → to_be_bytes; Float/Double 经 bitcast

// ---- U8 (u8, 1 字节) ----
/// v8: src/base/numerics/byte_conversions.h U8FromNativeEndian
pub fn u8_from_native_endian(bytes: [u8; 1]) -> u8 { u8::from_ne_bytes(bytes) }
/// v8: src/base/numerics/byte_conversions.h U8FromLittleEndian
pub fn u8_from_little_endian(bytes: [u8; 1]) -> u8 { u8::from_le_bytes(bytes) }
/// v8: src/base/numerics/byte_conversions.h U8FromBigEndian
pub fn u8_from_big_endian(bytes: [u8; 1]) -> u8 { u8::from_be_bytes(bytes) }
/// v8: src/base/numerics/byte_conversions.h U8ToNativeEndian
pub fn u8_to_native_endian(val: u8) -> [u8; 1] { val.to_ne_bytes() }
/// v8: src/base/numerics/byte_conversions.h U8ToLittleEndian
pub fn u8_to_little_endian(val: u8) -> [u8; 1] { val.to_le_bytes() }
/// v8: src/base/numerics/byte_conversions.h U8ToBigEndian
pub fn u8_to_big_endian(val: u8) -> [u8; 1] { val.to_be_bytes() }
/// Float/Double 走 bitcast (f32 ↔ u32, f64 ↔ u64) 再换端序 — Developer 补


