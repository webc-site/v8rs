// 由 tool/src/compiler/backend/unwinding-info-writer.js 从 v8/src/compiler/backend/unwinding-info-writer.h 生成; 修订就地改, 复跑覆盖
// UnwindingInfoWriter 架构分发壳 (占位类为不支持架构的空实现)

//! 台账: 纯 #if 分发头 — 实现见各架构镜像 (各架构头自带同名类的真实定义):
//! - V8_TARGET_ARCH_ARM → src/compiler/backend/arm/unwinding-info-writer-arm.h
//! - V8_TARGET_ARCH_ARM64 → src/compiler/backend/arm64/unwinding-info-writer-arm64.h
//! - V8_TARGET_ARCH_X64 → src/compiler/backend/x64/unwinding-info-writer-x64.h
//! - V8_TARGET_ARCH_S390X → src/compiler/backend/s390/unwinding-info-writer-s390.h
//! - V8_TARGET_ARCH_PPC64 → src/compiler/backend/ppc/unwinding-info-writer-ppc.h
//! 其他架构 (ia32/mips64/loong64/riscv) 走 #else 占位类: 5 空方法 +
//!   eh_frame_writer()=nullptr + static_assert(!perf_prof_unwinding_info)。

/// v8: UnwindingInfoWriter 占位面 (不支持架构) — 真实面在架构镜像文件
