    /// v8: last_bytes_marked_
    last_bytes_marked: usize,
    /// v8: is_marking_ / main_marking_disabled_for_testing_ / visited_cross_thread_persistents_in_atomic_pause_ / processed_cross_thread_weakness_
    is_marking: bool,
