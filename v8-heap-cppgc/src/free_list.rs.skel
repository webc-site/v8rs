    /// v8: src/heap/cppgc-internal/free-list.cc FreeList::Clear
    pub fn clear(&mut self) {
        self.heads.fill(core::ptr::null_mut());
        self.tails.fill(core::ptr::null_mut());
        self.biggest_free_list_index = 0;
    }

