/// v8: src/heap/cppgc-internal/explicit-management.cc InGC
fn in_gc(heap: &HeapBase) -> bool {
    heap.in_atomic_pause() || heap.marker().is_some() || heap.sweeper().is_sweeping_in_progress()
}

