// 由 tool/src/wasm/function-compiler.cc.js 从 v8/src/wasm/function-compiler.cc 生成; 修订就地改, 复跑覆盖
// tier 分派 + 计数器名表 + 方法台账

//! 编译单元执行分派与度量台账。

/// ExecuteCompilation 的 tier 分派 (4 路含条件编译项)
/// v8: src/wasm/function-compiler.cc WasmCompilationUnit::ExecuteCompilation
#[rustfmt::skip]
pub static TIER_DISPATCH: &[(&str, &str)] = &[
  ("None", "UNREACHABLE"),
  ("Interpreter", "UNREACHABLE (仅 V8_ENABLE_DRUMBRAKE 时出现在分派表)"),
  ("Liftoff", "tier_mask_for_testing 命中且非 must_use_liftoff 时跳过; 成功即止; 失败且非 liftoff_only 回落 Turbofan"),
  ("Turbofan", "ExecuteTurboshaftWasmCompilation; 结果 for_debugging 对齐请求值"),
];

/// Liftoff 前置开关规则
/// v8: src/wasm/function-compiler.cc WasmCompilationUnit::ExecuteCompilation
pub mod liftoff_gate {
    /// must_use_liftoff = liftoff_only || for_debugging != kNotForDebugging
    pub const MUST_USE_LIFTOFF_OR_DEBUGGING: bool = true;
    /// tiering_requested = declared_index < 32 && (wasm_tier_mask_for_testing & (1 << declared_index))
    pub const TIER_MASK_BIT_INDEX_LIMIT: u32 = 32;
    /// wasm_code_coverage 且非调试编译时, 提升为 kForDebugging
    pub const CODE_COVERAGE_FORCES_DEBUGGING: bool = true;
}

/// 巨型函数阈值: 函数体 >= 100 * KB 时额外采样尺寸与耗时直方图
/// v8: src/wasm/function-compiler.cc WasmCompilationUnit::ExecuteCompilation
pub const HUGE_FUNCTION_BODY_KB: usize = 100;

/// 计数器/直方图名表 (6 条, .cc 中实际引用)
/// v8: src/wasm/function-compiler.cc
#[rustfmt::skip]
pub static COUNTERS: &[&str] = &[
  "wasm_generated_code_size",
  "wasm_reloc_size",
  "wasm_deopt_data_size",
  "wasm_wasm_huge_function_size_bytes",
  "wasm_compile_huge_function_time",
  "wasm_compile_wasm_function_time",
];

/// 方法定义台账 (7 条, .cc 侧)
/// v8: src/wasm/function-compiler.cc
#[rustfmt::skip]
pub static METHODS: &[(&str, &str, u32)] = &[
  ("WasmCompilationUnit", "ExecuteCompilation", 28),
  ("WasmCompilationUnit", "CompileWasmFunction", 166),
  ("JSToWasmWrapperCompilationUnit", "JSToWasmWrapperCompilationUnit", 195),
  ("JSToWasmWrapperCompilationUnit", "~JSToWasmWrapperCompilationUnit", 214),
  ("JSToWasmWrapperCompilationUnit", "Execute", 216),
  ("JSToWasmWrapperCompilationUnit", "Finalize", 225),
  ("JSToWasmWrapperCompilationUnit", "CompileJSToWasmWrapper", 255),
];

// —— 提取不变式断言 ——
const _: () = {
    assert!(TIER_DISPATCH.len() == 4);
    assert!(COUNTERS.len() == 6);
    assert!(METHODS.len() == 7);
    assert!(HUGE_FUNCTION_BODY_KB == 100);
};
