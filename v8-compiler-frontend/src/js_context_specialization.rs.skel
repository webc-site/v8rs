    fn reduce_jsload_context_no_cell(&mut self, node: &Node) -> Reduction;
    /// v8: src/compiler/js-context-specialization.h JSContextSpecialization::ReduceJSLoadContext
    fn reduce_jsload_context(&mut self, node: &Node) -> Reduction;
    /// v8: src/compiler/js-context-specialization.h JSContextSpecialization::ReduceJSStoreContextNoCell
    fn reduce_jsstore_context_no_cell(&mut self, node: &Node) -> Reduction;
    /// v8: src/compiler/js-context-specialization.h JSContextSpecialization::ReduceJSStoreContext
    fn reduce_jsstore_context(&mut self, node: &Node) -> Reduction;
    /// v8: src/compiler/js-context-specialization.h JSContextSpecialization::ReduceJSGetImportMeta
    fn reduce_jsget_import_meta(&mut self, node: &Node) -> Reduction;

    // —— Simplify 家族 (4): 换 context + 深度重算, 距离不够则补 Load ——
    /// v8: src/compiler/js-context-specialization.h JSContextSpecialization::SimplifyJSLoadContextNoCell
    fn simplify_jsload_context_no_cell(&mut self, node: &Node, new_context: NodeRef, new_depth: usize) -> Reduction;
    /// v8: src/compiler/js-context-specialization.h JSContextSpecialization::SimplifyJSLoadContext
    fn simplify_jsload_context(&mut self, node: &Node, new_context: NodeRef, new_depth: usize) -> Reduction;
    /// v8: src/compiler/js-context-specialization.h JSContextSpecialization::SimplifyJSStoreContextNoCell
    fn simplify_jsstore_context_no_cell(&mut self, node: &Node, new_context: NodeRef, new_depth: usize) -> Reduction;
    /// v8: src/compiler/js-context-specialization.h JSContextSpecialization::SimplifyJSStoreContext
    fn simplify_jsstore_context(&mut self, node: &Node, new_context: NodeRef, new_depth: usize) -> Reduction;
