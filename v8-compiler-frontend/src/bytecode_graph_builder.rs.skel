  // —— BYTECODE_CASE 派发表 (VisitSingleBytecode 内 switch, 宏展开) ——
  /// 派发目标清单 (192 个 Visit<Name>, 宏先展开产物)
    // Bytecode::kldaZero → VisitLdaZero
    // Bytecode::kldaSmi → VisitLdaSmi
    // Bytecode::kldaConstant → VisitLdaConstant
    // Bytecode::kldaUndefined → VisitLdaUndefined
    // Bytecode::kldaNull → VisitLdaNull
    // Bytecode::kldaTheHole → VisitLdaTheHole
    // Bytecode::kldaTdzHole → VisitLdaTdzHole
    // Bytecode::kldaTrue → VisitLdaTrue
    // Bytecode::kldaFalse → VisitLdaFalse
    // Bytecode::kldar → VisitLdar
    // Bytecode::kstar → VisitStar
    // Bytecode::kmov → VisitMov
    // Bytecode::kldaGlobal → VisitLdaGlobal
    // Bytecode::kldaGlobalInsideTypeof → VisitLdaGlobalInsideTypeof
    // Bytecode::kstaGlobal → VisitStaGlobal
    // Bytecode::kstaInArrayLiteral → VisitStaInArrayLiteral
    // Bytecode::kdefineKeyedOwnPropertyInLiteral → VisitDefineKeyedOwnPropertyInLiteral
    // Bytecode::kldaContextSlotNoCell → VisitLdaContextSlotNoCell
    // Bytecode::kldaContextSlot → VisitLdaContextSlot
    // Bytecode::kldaImmutableContextSlot → VisitLdaImmutableContextSlot
    // Bytecode::kldaCurrentContextSlotNoCell → VisitLdaCurrentContextSlotNoCell
    // Bytecode::kldaCurrentContextSlot → VisitLdaCurrentContextSlot
    // Bytecode::kldaImmutableCurrentContextSlot → VisitLdaImmutableCurrentContextSlot
    // Bytecode::kstaContextSlotNoCell → VisitStaContextSlotNoCell
    // Bytecode::kstaCurrentContextSlotNoCell → VisitStaCurrentContextSlotNoCell
    // Bytecode::kstaContextSlot → VisitStaContextSlot
    // Bytecode::kstaCurrentContextSlot → VisitStaCurrentContextSlot
    // Bytecode::kldaLookupSlot → VisitLdaLookupSlot
    // Bytecode::kldaLookupSlotInsideTypeof → VisitLdaLookupSlotInsideTypeof
    // Bytecode::kldaLookupContextSlotNoCell → VisitLdaLookupContextSlotNoCell
    // Bytecode::kldaLookupContextSlot → VisitLdaLookupContextSlot
    // Bytecode::kldaLookupContextSlotNoCellInsideTypeof → VisitLdaLookupContextSlotNoCellInsideTypeof
    // Bytecode::kldaLookupContextSlotInsideTypeof → VisitLdaLookupContextSlotInsideTypeof
    // Bytecode::kldaLookupGlobalSlot → VisitLdaLookupGlobalSlot
    // Bytecode::kldaLookupGlobalSlotInsideTypeof → VisitLdaLookupGlobalSlotInsideTypeof
    // Bytecode::kstaLookupSlot → VisitStaLookupSlot
    // Bytecode::kgetNamedProperty → VisitGetNamedProperty
    // Bytecode::kgetNamedPropertyFromSuper → VisitGetNamedPropertyFromSuper
    // Bytecode::kgetKeyedProperty → VisitGetKeyedProperty
    // Bytecode::kgetEnumeratedKeyedProperty → VisitGetEnumeratedKeyedProperty
    // Bytecode::kgetPrivateField → VisitGetPrivateField
    // Bytecode::ksetPrivateField → VisitSetPrivateField
    // Bytecode::ksetPrototypeProperties → VisitSetPrototypeProperties
    // Bytecode::ksetNamedProperty → VisitSetNamedProperty
    // Bytecode::kdefineNamedOwnProperty → VisitDefineNamedOwnProperty
    // Bytecode::kdefineNamedOwnPropertyInLiteral → VisitDefineNamedOwnPropertyInLiteral
    // Bytecode::ksetKeyedProperty → VisitSetKeyedProperty
    // Bytecode::kdefineKeyedOwnProperty → VisitDefineKeyedOwnProperty
    // Bytecode::kldaModuleVariable → VisitLdaModuleVariable
    // Bytecode::kstaModuleVariable → VisitStaModuleVariable
    // Bytecode::kpushContext → VisitPushContext
    // Bytecode::kpopContext → VisitPopContext
    // Bytecode::kcreateClosure → VisitCreateClosure
    // Bytecode::kcreateBlockContext → VisitCreateBlockContext
