            // Runtime::InlineDeoptimizeNow => reduce_deoptimize_now() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineDeoptimizeNow
            // Runtime::InlineGeneratorClose => reduce_generator_close() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineGeneratorClose
            // Runtime::InlineCreateJSGeneratorObject => reduce_create_jsgenerator_object() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineCreateJSGeneratorObject
            // Runtime::InlineAsyncFunctionAwait => reduce_async_function_await() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineAsyncFunctionAwait
            // Runtime::InlineAsyncFunctionEnter => reduce_async_function_enter() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineAsyncFunctionEnter
            // Runtime::InlineAsyncFunctionReject => reduce_async_function_reject() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineAsyncFunctionReject
            // Runtime::InlineAsyncFunctionResolve => reduce_async_function_resolve() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineAsyncFunctionResolve
            // Runtime::InlineAsyncGeneratorAwait => reduce_async_generator_await() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineAsyncGeneratorAwait
            // Runtime::InlineAsyncGeneratorReject => reduce_async_generator_reject() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineAsyncGeneratorReject
            // Runtime::InlineAsyncGeneratorResolve => reduce_async_generator_resolve() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineAsyncGeneratorResolve
            // Runtime::InlineAsyncGeneratorYieldWithAwait => reduce_async_generator_yield_with_await() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineAsyncGeneratorYieldWithAwait
            // Runtime::InlineGeneratorGetResumeMode => reduce_generator_get_resume_mode() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineGeneratorGetResumeMode
            // Runtime::InlineIncBlockCounter => reduce_inc_block_counter() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineIncBlockCounter
            // Runtime::InlineAddLhsIsStringConstantInternalize => reduce_add_lhs_is_string_constant_internalize() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineAddLhsIsStringConstantInternalize
            // Runtime::InlineAddRhsIsStringConstantInternalize => reduce_add_rhs_is_string_constant_internalize() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineAddRhsIsStringConstantInternalize
            // Runtime::InlineGetImportMetaObject => reduce_get_import_meta_object() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineGetImportMetaObject
