            _ => {}
        }
        if !is_inline_intrinsic(node) { return NoChange; }
        match runtime_function_id(node) {
            // Runtime::InlineCopyDataProperties => reduce_copy_data_properties() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineCopyDataProperties
            // Runtime::InlineCopyDataPropertiesWithExcludedPropertiesOnStack => reduce_copy_data_properties_with_excluded_properties_on_stack() /// v8: src/compiler/js-intrinsic-lowering.cc case Runtime::InlineCopyDataPropertiesWithExcludedPropertiesOnStack
